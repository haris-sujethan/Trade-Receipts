# Copy to .env (gitignored) and fill in your own values. Never commit .env.

# Build steps 1–2: the pump.fun data pipeline
GOOGLE_CLOUD_PROJECT=your-project-id
HELIUS_API_KEY=your-key

# Optional limits (defaults shown). The BigQuery sandbox allows 1 TiB of queries a month.
# BQ_MONTHLY_BUDGET_GIB=900
# BQ_QUERY_CAP_GIB=60
# HELIUS_MONTHLY_BUDGET_CREDITS=900000

# Build step 4: training Glimmer on Kaggle's free GPUs
HF_TOKEN=your-write-token
KAGGLE_API_TOKEN=your-kaggle-token

# Build step 6: the agent. Stays off unless you turn it on (CLAUDE.md, Guardrails).
# MODEL_API_KEY=
# META_API_ENABLED=false
# Muse Spark goes to the contributor model (1/12 the price; Meta may train on the content). Default on.
# META_CONTRIBUTOR=true

# Live checks on a public backend (defaults shown): per visitor per hour, and for the whole site per day.
# CHECKS_PER_HOUR=6
# CHECKS_PER_DAY=60
