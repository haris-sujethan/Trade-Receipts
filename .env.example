# Copy to .env (gitignored) and fill in your own values. Never commit .env.

# Build steps 1–2: the pump.fun data pipeline
GOOGLE_CLOUD_PROJECT=your-project-id
HELIUS_API_KEY=your-key

# Optional limits (defaults shown). The BigQuery sandbox allows 1 TiB of queries a month.
# BQ_MONTHLY_BUDGET_GIB=900
# BQ_QUERY_CAP_GIB=60
# HELIUS_MONTHLY_BUDGET_CREDITS=900000

# Build step 4: training Glimmer
# HF_TOKEN=

# Build step 6: the agent. Stays off unless you turn it on (CLAUDE.md, Guardrails).
# MODEL_API_KEY=
# META_API_ENABLED=false
