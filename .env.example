# Copy to .env (gitignored) and fill in your own values. Never commit .env.

# The pump.fun data pipeline: past launches from BigQuery, live tokens from Helius
GOOGLE_CLOUD_PROJECT=your-project-id
HELIUS_API_KEY=your-key

# Optional limits (defaults shown). The BigQuery sandbox allows 1 TiB of queries a month.
# BQ_MONTHLY_BUDGET_GIB=900
# BQ_QUERY_CAP_GIB=60
# HELIUS_MONTHLY_BUDGET_CREDITS=900000

# Training and scoring Glimmer on Kaggle's free GPUs
HF_TOKEN=your-write-token
KAGGLE_API_TOKEN=your-kaggle-token

# The agent from the command line (in the app, each visitor adds their own key in Settings).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# A hosted backend: Supabase sign-in, the site allowed to call it, and a time budget for checks.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# ALLOWED_ORIGINS=https://tradereceipts.io,https://www.tradereceipts.io
# LIVE_TIME_BUDGET_S=200

# Live checks on a public backend (defaults shown): per account per hour, and for the whole site per day.
# CHECKS_PER_HOUR=6
# CHECKS_PER_DAY=60
